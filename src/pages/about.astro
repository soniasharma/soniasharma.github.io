---
import Base from '../layouts/Base.astro';
import { site } from '../site';
---

<Base title="About">
  <article class="prose">
    <h1>About</h1>
    <p>
      I'm Sonia. I work in software, and this is where I think out loud about it —
      the technical parts, the organizational parts, and the messy places where
      those two overlap.
    </p>
    <p>
      Opinions here are mine, not my employer's.
    </p>
    <p>
      Find me on <a href={site.links.linkedin}>LinkedIn</a> or
      <a href={site.links.github}>GitHub</a>.
    </p>
  </article>
</Base>
